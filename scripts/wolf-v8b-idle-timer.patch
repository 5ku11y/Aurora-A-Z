+static uint64_t wolf_runtime_now_ms(void)
+{
+    int64_t now_100ns = 0;
+
+    KeQuerySystemTime(&now_100ns);
+    if (now_100ns <= 0) {
+        return 0u;
+    }
+    return (uint64_t)now_100ns / 10000u;
+}
