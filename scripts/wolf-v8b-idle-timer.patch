+static void flush_wolf_v8b_idle_marker(void)
+{
+    AzInputDetourStatus status;
+    const uint64_t now_ms = wolf_runtime_now_ms();
+    const WolfV8bIdleMarker marker = {
+        {'W', 'F', '8', 'B'},
+        WOLF_V8B_IDLE_MARKER_VERSION,
+        (uint32_t)sizeof(WolfV8bIdleMarker),
+        WOLF_IDLE_TIMER_DEFAULT_THRESHOLD_MS,
+        g_runtime.wolf_idle_timer.fired == 0u ? 1u : 0u,
+        g_runtime.wolf_idle_timer.fired != 0u ? 1u : 0u,
+        g_runtime.wolf_idle_timer.reset_count,
+        g_runtime.wolf_idle_timer.trigger_count,
+        wolf_idle_timer_elapsed_ms(&g_runtime.wolf_idle_timer, now_ms),
+        g_runtime.wolf_idle_timer.last_activity_serial,
+        g_runtime.wolf_idle_timer.last_input_frame,
+        load_u32(&g_runtime.state),
+        0u,
+        0u,
+        0u,
+        0u
+    };
+    WolfV8bIdleMarker snapshot = marker;
+
+    az_rev1655_input_detour_snapshot_status(&status);
+    snapshot.requested_stage = (uint32_t)status.requested_stage;
+    snapshot.effective_stage = (uint32_t)status.effective_stage;
+    snapshot.consumed_controls = status.consumed_controls;
+    snapshot.observation_drops = status.observation_drops;
+    if (write_complete_file(
+            g_wolf_v8b_idle_marker_path,
+            (const uint8_t *)&snapshot,
+            (uint32_t)sizeof(snapshot)) == 0u) {
+        DbgPrint("WolfFactory V8B: idle marker write failed\n");
+    }
+}
